# Alatas — every credential lives in env/.env (copy this file to env/.env).
# The web app, mobile app and local API all read from this one file.

# ===== Web app (Vite) — VITE_* =====
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_USE_SUPABASE=true
# Legacy Render sync — keep false when using Supabase
VITE_CLOUD_SYNC_ENABLED=false
VITE_RENDER_API_URL=

# ===== Mobile app (Expo) — EXPO_PUBLIC_* =====
# Optional: leave blank to reuse the VITE_SUPABASE_* values above.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_USE_SUPABASE=true

# ===== Local API (backend/) =====
RENDER_API_URL=https://alatas.onrender.com
# Set to 1 to push/pull via Render (requires RENDER_API_URL)
CLOUD_SYNC_ENABLED=1

# ===== Render server (render-backend/) — set these on the Render dashboard =====
# PORT=4000
# HOST=0.0.0.0
# ALATAS_DATA_DIR=/var/data
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
