# EAS / Expo (optional — eas init fills projectId into app.json)
# EAS_PROJECT_ID=

# Production / cloud API (baked into EAS builds via eas.json env)
EXPO_PUBLIC_API_URL=https://alatas.onrender.com

# Dev: mobile talks to desk backend (npm start). Physical phone on Wi‑Fi — set your PC IP:
# EXPO_PUBLIC_DEV_API_URL=http://192.168.x.x:4000
# Force cloud in dev (only after Render is redeployed):
# EXPO_PUBLIC_USE_CLOUD=true
