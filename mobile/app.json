{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logonobg.png",
    "splash": {
      "image": "./assets/splash_logonobg.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.uryzei.mobile"
    },
    "web": {
      "favicon": "./assets/logonobg.png"
    },
    "plugins": [
      [
        "@morrowdigital/watermelondb-expo-plugin",
        {
          "iosJsi": false,
          "androidJsi": false
        }
      ],

      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Alatas to access photos for field inspections.",
          "cameraPermission": "Allow Alatas to use the camera for field inspections."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {}
        }
      ]
    ]
  }
}
