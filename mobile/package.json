{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@nozbe/watermelondb": "^0.28.1-0",
    "@nozbe/with-observables": "^1.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "~57.0.16",
    "expo-build-properties": "~57.0.14",
    "expo-dev-client": "~57.0.15",
    "expo-image-picker": "~57.0.13",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "^57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-android.ps1",
    "android:jdk17": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-android.ps1",
    "android:rebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-android.ps1 -Rebuild",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:login": "npx eas-cli login",
    "eas:init": "npx eas-cli init",
    "eas:build:android": "npx eas-cli build --platform android --profile preview",
    "eas:build:android:prod": "npx eas-cli build --platform android --profile production",
    "eas:build:ios": "npx eas-cli build --platform ios --profile preview",
    "eas:build:ios:prod": "npx eas-cli build --platform ios --profile production",
    "eas:build:dev": "npx eas-cli build --platform android --profile development"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson",
          "@nozbe/with-observables"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "babel-preset-expo": "^57.0.7"
  }
}
