# Copy this file to .env and paste the SAME values as frontend/.env (VITE_* → EXPO_PUBLIC_*).
# Do NOT leave placeholder URLs — sign-in will show "Failed to fetch".
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
EXPO_PUBLIC_USE_SUPABASE=true
